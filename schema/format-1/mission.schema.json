{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shall mission file, format 1",
  "type": "object",
  "required": ["title", "mission"],
  "additionalProperties": false,
  "properties": {
    "title": { "$ref": "items.schema.json#/$defs/text" },
    "mission": { "$ref": "items.schema.json#/$defs/text" },
    "ranking": { "type": "array", "items": { "$ref": "items.schema.json#/$defs/objectiveId" } },
    "items": { "$ref": "items.schema.json#/$defs/items" },
    "retired": { "$ref": "items.schema.json#/$defs/retired" }
  }
}
