{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shall items, format 1",
  "$defs": {
    "id": { "type": "string", "pattern": "^[OSNRT][1-9][0-9]*(\\.[1-9][0-9]*)*$" },
    "objectiveId": { "type": "string", "pattern": "^O[1-9][0-9]*(\\.[1-9][0-9]*)*$" },
    "stakeholderId": { "type": "string", "pattern": "^S[1-9][0-9]*(\\.[1-9][0-9]*)*$" },
    "needId": { "type": "string", "pattern": "^N[1-9][0-9]*(\\.[1-9][0-9]*)*$" },
    "requirementId": { "type": "string", "pattern": "^R[1-9][0-9]*(\\.[1-9][0-9]*)*$" },
    "foreign": { "type": "string", "pattern": "^[a-z][a-z0-9-]*/[OSNR][1-9][0-9]*(\\.[1-9][0-9]*)*$" },
    "text": { "type": "string", "minLength": 1 },

    "notes": { "type": "array", "items": { "$ref": "#/$defs/text" } },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["url"],
        "additionalProperties": false,
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "title": { "$ref": "#/$defs/text" }
        }
      }
    },
    "retired": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "title": { "$ref": "#/$defs/text" }
        }
      }
    },

    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } },
    "item": {
      "type": "object",
      "if": { "$ref": "#/$defs/kindO" },
      "then": { "$ref": "#/$defs/objective" },
      "else": {
        "if": { "$ref": "#/$defs/kindS" },
        "then": { "$ref": "#/$defs/stakeholder" },
        "else": {
          "if": { "$ref": "#/$defs/kindN" },
          "then": { "$ref": "#/$defs/need" },
          "else": {
            "if": { "$ref": "#/$defs/kindR" },
            "then": { "$ref": "#/$defs/requirement" },
            "else": {
              "if": { "$ref": "#/$defs/kindT" },
              "then": { "$ref": "#/$defs/topic" },
              "else": { "required": ["id"], "properties": { "id": { "$ref": "#/$defs/id" } } }
            }
          }
        }
      }
    },
    "kindO": { "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^O" } } },
    "kindS": { "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^S" } } },
    "kindN": { "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^N" } } },
    "kindR": { "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^R" } } },
    "kindT": { "required": ["id"], "properties": { "id": { "type": "string", "pattern": "^T" } } },

    "objective": {
      "required": ["id", "title", "text"],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/objectiveId" },
        "title": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "measure": { "$ref": "#/$defs/text" },
        "mirrors": { "$ref": "#/$defs/foreign" },
        "notes": { "$ref": "#/$defs/notes" },
        "links": { "$ref": "#/$defs/links" },
        "retired": { "$ref": "#/$defs/retired" },
        "children": { "$ref": "#/$defs/items" }
      }
    },

    "stakeholder": {
      "required": ["id", "title", "text"],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/stakeholderId" },
        "title": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "mirrors": { "$ref": "#/$defs/foreign" },
        "notes": { "$ref": "#/$defs/notes" },
        "links": { "$ref": "#/$defs/links" },
        "retired": { "$ref": "#/$defs/retired" },
        "children": { "$ref": "#/$defs/items" }
      }
    },

    "need": {
      "required": ["id", "title", "text", "status"],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/needId" },
        "title": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "stakeholders": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/stakeholderId" } },
        "serves": {
          "type": "array",
          "minItems": 1,
          "items": { "anyOf": [{ "$ref": "#/$defs/objectiveId" }, { "const": "mission" }] }
        },
        "status": { "enum": ["hypothesis", "validated"] },
        "mirrors": { "$ref": "#/$defs/foreign" },
        "notes": { "$ref": "#/$defs/notes" },
        "links": { "$ref": "#/$defs/links" },
        "retired": { "$ref": "#/$defs/retired" },
        "children": { "$ref": "#/$defs/items" }
      }
    },

    "requirement": {
      "required": ["id", "title", "text"],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/requirementId" },
        "title": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "serves": {
          "type": "array",
          "minItems": 1,
          "items": {
            "anyOf": [
              { "$ref": "#/$defs/needId" },
              { "$ref": "#/$defs/requirementId" },
              { "$ref": "#/$defs/foreign" }
            ]
          }
        },
        "rationale": { "$ref": "#/$defs/text" },
        "verify": { "enum": ["test", "inspection", "analysis", "demonstration"] },
        "status": { "enum": ["draft", "approved", "implemented", "verified", "waived"] },
        "mirrors": { "$ref": "#/$defs/foreign" },
        "notes": { "$ref": "#/$defs/notes" },
        "links": { "$ref": "#/$defs/links" },
        "retired": { "$ref": "#/$defs/retired" },
        "children": { "$ref": "#/$defs/items" }
      }
    },

    "topic": {
      "required": ["id", "title"],
      "unevaluatedProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^T[1-9][0-9]*(\\.[1-9][0-9]*)*$" },
        "title": { "$ref": "#/$defs/text" },
        "text": { "$ref": "#/$defs/text" },
        "links": { "$ref": "#/$defs/links" },
        "retired": { "$ref": "#/$defs/retired" },
        "children": { "$ref": "#/$defs/items" }
      }
    }
  }
}
